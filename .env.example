# MobiMatch Server Environment Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mobimatch

# Cache (Redis - optional in local dev; falls back safely to Postgres)
REDIS_URL=redis://localhost:6379

# JWT Secrets for Session Management
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000

# Bootstrapping First Admin
INITIAL_ADMIN_EMAIL=admin@mobimatch.local

# Google OAuth
GOOGLE_CLIENT_IDS=your-android-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com
# Set DEV_MOCK_AUTH=true in test/local environments to bypass external Google JWKS fetch
DEV_MOCK_AUTH=true

# Operational & Maintenance Mode
APP_MAINTENANCE_MODE=false
APP_MAINTENANCE_MESSAGE="MobiMatch is undergoing scheduled maintenance. Please check back shortly."

# Minimum App Versions (for update-required enforcement)
MIN_USER_APP_VERSION=1.0.0
MIN_ADMIN_APP_VERSION=1.0.0
LATEST_USER_APP_VERSION=1.0.0
LATEST_ADMIN_APP_VERSION=1.0.0
USER_APP_UPDATE_URL=https://play.google.com/store/apps/details?id=com.mobimatch.app
ADMIN_APP_UPDATE_URL=https://mobimatch.local/admin-update
