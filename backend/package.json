{
  "name": "mobimatch-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'); if(fs.existsSync('migrations')){fs.cpSync('migrations','dist/migrations',{recursive:true,errorOnExist:false});}\"",
    "postinstall": "tsc || true",
    "start": "node dist/server.js",
    "db:migrate": "node -e \"require('./dist/db').runMigrations().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1);})\"",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@mobimatch/api-contracts": "*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.1",
    "fastify": "^4.28.1",
    "google-auth-library": "^9.14.2",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "uuid": "^10.0.0",
    "zod": "~3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.28.1",
    "pg-mem": "^3.0.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
